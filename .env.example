# LiteLLM-routed model endpoint used by app/core/llm.py (service) and
# examples/k8s_rabbit_hole.py (standalone script) alike.
LITELLM_API_BASE=https://your-litellm-host
LITELLM_API_KEY=your-litellm-api-key
LITELLM_API_MODEL=openai/gpt-4.1-20250414-global
LITELLM_MAX_TOKENS=4096

# Namespaces the agent is permitted to inspect (and, for the write tools,
# mutate once an operator approves). Comma-separated. Empty = deny all.
KUBE_ALLOWED_NAMESPACES=default,staging

# Hop budget for one investigation before the agent is forced to converge.
KUBE_MAX_HOPS=8

# How long a pending restart/rollback approval waits before it is treated
# as rejected.
APPROVAL_TIMEOUT_SECONDS=600

# Port for the dedicated /healthz, /readyz and /metrics server (runs on
# its own thread, separate from the main app's port and event loop).
HEALTH_PORT=8001

# How often the main event loop stamps a heartbeat that the health server
# checks (seconds).
HEARTBEAT_INTERVAL_SECONDS=2

# How long the heartbeat can go unrefreshed before /healthz and /readyz
# report the loop as stalled (seconds).
HEALTH_STALE_SECONDS=10

# How often to re-check kubectl/LiteLLM reachability for /readyz and
# /metrics (seconds). Coarser than HEARTBEAT_INTERVAL_SECONDS since each
# check costs a real network call.
DEPENDENCY_CHECK_INTERVAL_SECONDS=15

# OpenTelemetry distributed tracing (opt-in). Leave OTEL_EXPORTER_OTLP_ENDPOINT
# empty to disable tracing entirely; set it to an OTLP/HTTP collector to trace
# each investigation end to end (inbound request -> agent workflow -> LLM
# calls). The endpoint is the collector base URL; the exporter appends
# /v1/traces. Auth headers, if any, go in OTEL_EXPORTER_OTLP_HEADERS.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=kubeagent
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer <token>
